          "editorMode": "code",
          "expr": "sum by (prompt_id) (increase(prompt_feedback_total{action=\"accept\"}[7d])) / clamp_min(sum by (prompt_id) (increase(prompt_feedback_total[7d])), 1)",
          "legendFormat": "{{prompt_id}}",
          "range": true,
          "refId": "A"
        }
      ],
