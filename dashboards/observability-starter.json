{
  "title": "Maintenance Intelligence — Observability Starter",
  "panels": [
    {
      "type": "timeseries",
      "title": "RCA Runs / Failures",
      "targets": [
        { "expr": "rca_runs_total" },
        { "expr": "rca_failures_total" }
      ]
    },
    {
      "type": "timeseries",
      "title": "RCA Duration (p50/p95)",
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(rca_duration_seconds_bucket[5m])))" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(rca_duration_seconds_bucket[5m])))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingestion / Recommendations / WOs",
      "targets": [
        { "expr": "rate(events_ingested_total[5m])" },
        { "expr": "rate(recommendations_created_total[5m])" },
        { "expr": "rate(wo_drafts_total[5m])" }
      ]
    },
    {
      "type": "table",
      "title": "Kafka Lag by Group",
      "targets": [
        { "expr": "kafka_consume_lag" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}